# Copy to .env on the VPS:   cp hostinger.env.example .env   then edit.
# Never commit .env. If a value contains a $ sign, wrap it in single quotes.

# ---- Your domains (no https://, no trailing slash) --------------------------
STUDENT_DOMAIN=yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# ---- Database: your Supabase Postgres connection string ---------------------
# Supabase dashboard -> Connect -> "Session pooler" (works over IPv4).
DATABASE_URL='postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres'

# ---- Auth: copy the SAME value from Railway so existing logins stay valid ---
JWT_SECRET=

# ---- First-boot admin (only used if the database has no admin yet) ----------
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# ---- Email (copy from Railway) ----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@yourdomain.com

# ---- File storage (copy from Railway; required for uploads) -----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Optional AI features (copy from Railway if you use them) ---------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Anything else you have set in Railway's Variables tab: add it below ----
