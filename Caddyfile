# Caddy: HTTPS certificates are issued and renewed automatically.
# STUDENT_DOMAIN / ADMIN_DOMAIN / ACME_EMAIL come from .env (via docker-compose.yml).

{
	email {$ACME_EMAIL}
}

# ---------------------------------------------------------------- student app
{$STUDENT_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		root * /srv/student
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

www.{$STUDENT_DOMAIN} {
	redir https://{$STUDENT_DOMAIN}{uri} permanent
}

# ------------------------------------------------------------------ admin app
{$ADMIN_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		root * /srv/admin
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
