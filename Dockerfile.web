# Builds BOTH frontends (student + admin) and serves them with Caddy, which
# also gets you automatic HTTPS and proxies /api/* to the API container.
# Build context = repository root:  docker compose build web

FROM node:22-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .
# Keep the Vite/tsc builds inside a small VPS's memory.
ENV NODE_OPTIONS=--max-old-space-size=3072
RUN pnpm install
# No VITE_API_BASE_URL on purpose: the frontends call the relative path /api,
# and Caddy forwards it to the API. Same-origin = first-party cookies, no CORS.
RUN pnpm run build:student && pnpm run build:admin

FROM caddy:2-alpine
COPY --from=build /repo/artifacts/frontend-student/dist/public /srv/student
COPY --from=build /repo/artifacts/frontend-admin/dist/public /srv/admin
COPY Caddyfile /etc/caddy/Caddyfile
